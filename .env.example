# Public API base URL used by the frontend.
# - Dev (with proxy): /api
# - Production (direct): https://api.yourdomain.com
VITE_API_URL=/api

# Dev-only Vite proxy target for requests sent to /api.
# Prefer 127.0.0.1 over localhost (Windows may resolve localhost to ::1).
# If another app already uses 8000, point this at SuperShyft's port (e.g. 8001).
VITE_DEV_PROXY_TARGET=http://127.0.0.1:8001
